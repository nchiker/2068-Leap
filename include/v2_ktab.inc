; R9 HOME/EXROM contract. Both images include this list and magic byte.
    IFNDEF V2_KTAB_INC
    DEFINE V2_KTAB_INC
V2_KTAB_BASE EQU $0040
V2_EXROM_ENTRY_ADDR EQU $C000
V2_EXROM_IMAGE_END EQU $E000
V2_EXROM_IMAGE_SIZE EQU V2_EXROM_IMAGE_END - V2_EXROM_ENTRY_ADDR
V2_EXROM_SAVE_ADDR EQU $C012
V2_EXROM_LOAD_ADDR EQU $C018
V2_EXROM_CALCULATE_ADDR EQU $C024
V2_EXROM_INT_TO_FP_ADDR EQU $C02A
V2_EXROM_FP_TO_INT_ADDR EQU $C030
V2_EXROM_PUSH_PI_ADDR EQU $C036
V2_EXROM_PUSH_FP_RAW_ADDR EQU $C03C
V2_EXROM_SOUND_ADDR EQU $C048
V2_EXROM_EDITOR_INIT_ADDR EQU $C060
V2_EXROM_EDITOR_ENTER_ADDR EQU $C066
V2_EXROM_EDITOR_WRAP_CALC_ADDR EQU $C06C
V2_EXROM_EDITOR_WRAP_OFFSET_ADDR EQU $C078
V2_EXROM_EDITOR_WRAP_ROWCOL_ADDR EQU $C07E
V2_EXROM_EDITOR_BLOCK_DELETE_ADDR EQU $C084
V2_EXROM_NUM_TO_STRING_ADDR EQU $C09C
V2_EXROM_FLOAT_TO_STRING_ADDR EQU $C0A8
V2_EXROM_SP_TO_PTR_ADDR EQU $C0D2
V2_EXROM_CLEAR_ADDR EQU $C0E0  ; R10.7 -- CLEAR statement, right after
                               ; V2_VERIFY_KTAB's own fixed 8-byte body
V2_EXROM_ARRSVC_ADDR EQU $C0E6
V2_EXROM_ARR_DIM_ADDR EQU V2_EXROM_ARRSVC_ADDR
V2_EXROM_ARR_DIM_STR_ADDR EQU V2_EXROM_ARRSVC_ADDR + 3
    IFDEF V2_KTAB_HOME
    MACRO V2_KTAB_ENTRY realname, ktabname
        jp realname
    ENDM
    ELSE
V2_KTAB_INDEX: DEFL 0
    MACRO V2_KTAB_ENTRY realname, ktabname
ktabname EQU V2_KTAB_BASE + 3*V2_KTAB_INDEX
V2_KTAB_INDEX: DEFL V2_KTAB_INDEX + 1
    ENDM
    ENDIF

    MACRO V2_KTAB_LIST
    V2_KTAB_ENTRY MEM_FILL_ZERO, KTAB_MEM_FILL_ZERO
    V2_KTAB_ENTRY MEM_SHIFT_UP, KTAB_MEM_SHIFT_UP
    V2_KTAB_ENTRY MEM_SHIFT_DOWN, KTAB_MEM_SHIFT_DOWN
    V2_KTAB_ENTRY MEM_LINE_DELETE_RANGE, KTAB_MEM_LINE_DELETE_RANGE
    V2_KTAB_ENTRY MEM_LINE_FIRST, KTAB_MEM_LINE_FIRST
    V2_KTAB_ENTRY MEM_LINE_NEXT, KTAB_MEM_LINE_NEXT
    V2_KTAB_ENTRY MEM_LINE_STORE, KTAB_MEM_LINE_STORE
    V2_KTAB_ENTRY MEM_LINE_INSERT, KTAB_MEM_LINE_INSERT
    V2_KTAB_ENTRY IO_READ_KEY, KTAB_IO_READ_KEY
    V2_KTAB_ENTRY GFX_CLS, KTAB_GFX_CLS
    V2_KTAB_ENTRY GFX_PRINT_STRING, KTAB_GFX_PRINT_STRING
    V2_KTAB_ENTRY GFX_INVERT_ATTR, KTAB_GFX_INVERT_ATTR
    V2_KTAB_ENTRY GFX_PUTCHAR, KTAB_GFX_PUTCHAR
    V2_KTAB_ENTRY GFX_CLEAR_ROW, KTAB_GFX_CLEAR_ROW
    V2_KTAB_ENTRY GFX_SET_BORDER, KTAB_GFX_SET_BORDER
    V2_KTAB_ENTRY GFX_SET_MODE, KTAB_GFX_SET_MODE
    V2_KTAB_ENTRY COMPILER_INIT, KTAB_COMPILER_INIT
    V2_KTAB_ENTRY COMPILE_PROGRAM, KTAB_COMPILE_PROGRAM
    V2_KTAB_ENTRY VM_INIT, KTAB_VM_INIT
    V2_KTAB_ENTRY VM_RUN, KTAB_VM_RUN
    V2_KTAB_ENTRY CALC_EXIT_TRAMPOLINE, KTAB_CALC_EXIT_TRAMPOLINE
    V2_KTAB_ENTRY EXT2_CLEAR_ALL, KTAB_EXT2_CLEAR_ALL
    V2_KTAB_ENTRY GFX_PUTCHAR_BOLD, KTAB_GFX_PUTCHAR_BOLD
    V2_KTAB_ENTRY V2_GET_KEYWORD_TABLE, KTAB_GET_KEYWORD_TABLE
    V2_KTAB_ENTRY GFX_SET_ATTR, KTAB_GFX_SET_ATTR
    V2_KTAB_ENTRY GFX_CLEAR_ROW_TEXT, KTAB_GFX_CLEAR_ROW_TEXT
    V2_KTAB_ENTRY CHUNK_REFILL, KTAB_CHUNK_REFILL
    ENDM
V2_KTAB_COUNT EQU 27
V2_KTAB_END EQU V2_KTAB_BASE + 3*V2_KTAB_COUNT
V2_KTAB_MAGIC_ADDR EQU V2_KTAB_END
V2_KTAB_MAGIC EQU $1A
    ENDIF
