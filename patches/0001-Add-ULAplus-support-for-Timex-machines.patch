@@ -42,6 +43,12 @@
 #include "ui/ui.h"
 #include "ui/uidisplay.h"
 
+#ifdef DISPLAYTEST
+int ulaplus_available;
+int ulaplus_palette_enabled;
+libspectrum_byte ulaplus_palette[ ULAPLUS_CLUT_MAX_COLOURS ];
+#endif
+
 /* Set once we have initialised the UI */
 int display_ui_initialised = 0;
 
@@ -728,6 +735,18 @@ void
 display_parse_attr( libspectrum_byte attr,
 		    libspectrum_byte *ink, libspectrum_byte *paper )
 {
+  static const libspectrum_byte normal_map[16] = {
+    0, 2, 20, 22, 160, 162, 180, 182,
+    0, 3, 28, 31, 224, 227, 252, 255
+  };
+
+  if( ulaplus_available && ulaplus_palette_enabled ) {
+    libspectrum_byte base = ( ( attr >> 6 ) & 3 ) << 4;
+    *ink = ulaplus_palette[ base + ( attr & 7 ) ];
+    *paper = ulaplus_palette[ base + ( ( attr >> 3 ) & 7 ) + 8 ];
+    return;
+  }
+
   if( (attr & 0x80) && display_flash_reversed ) {
     *ink  = (attr & ( 0x0f << 3 ) ) >> 3;
     *paper= (attr & 0x07) + ( (attr & 0x40) >> 3 );
@@ -735,6 +754,11 @@ display_parse_attr( libspectrum_byte attr,
     *ink= (attr & 0x07) + ( (attr & 0x40) >> 3 );
     *paper= (attr & ( 0x0f << 3 ) ) >> 3;
   }
+
+  if( ulaplus_available ) {
+    *ink = normal_map[ *ink ];
+    *paper = normal_map[ *paper ];
+  }
 }
 
 static void
@@ -776,6 +800,13 @@ check_border_change( void )
 void
 display_set_lores_border( int colour )
 {
+  static const libspectrum_byte normal_map[16] = {
+    0, 2, 20, 22, 160, 162, 180, 182,
+    0, 3, 28, 31, 224, 227, 252, 255
+  };
+  if( ulaplus_available )
+    colour = ulaplus_palette_enabled ? ulaplus_palette[ colour | 8 ]
+                                     : normal_map[ colour & 15 ];
   if( display_lores_border != colour ) {
     display_lores_border = colour;
   }
@@ -785,6 +816,13 @@ display_set_lores_border( int colour )
 void
