diff --git a/peripherals/ulaplus.c b/peripherals/ulaplus.c
new file mode 100644
index 00000000..878c9b24
--- /dev/null
+++ b/peripherals/ulaplus.c
@@ -0,0 +1,103 @@
+/* ULAplus palette device, ported from Fuse's 2014 ULAplus branch. */
+#include "config.h"
+
+#include <string.h>
+
+#include "compat.h"
+#include "display.h"
+#include "infrastructure/startup_manager.h"
+#include "module.h"
+#include "periph.h"
+#include "peripherals/ula.h"
+#include "peripherals/ulaplus.h"
+
+int ulaplus_available;
+int ulaplus_palette_enabled;
+libspectrum_byte ulaplus_palette[ ULAPLUS_CLUT_MAX_COLOURS ];
+static libspectrum_byte current_register;
+
+static void
+ulaplus_reset( int hard_reset GCC_UNUSED )
+{
+  ulaplus_available = periph_is_active( PERIPH_TYPE_ULAPLUS );
+  ulaplus_palette_enabled = 0;
+  current_register = 0;
+  memset( ulaplus_palette, 0, sizeof( ulaplus_palette ) );
+}
+
+static void
+register_write( libspectrum_word port GCC_UNUSED, libspectrum_byte value )
+{
+  current_register = value;
+}
+
+static libspectrum_byte
+data_read( libspectrum_word port GCC_UNUSED, libspectrum_byte *attached )
+{
+  *attached = 0xff;
+  if( current_register < 64 ) return ulaplus_palette[ current_register ];
+  if( current_register == 64 ) return ulaplus_palette_enabled;
+  return 0xff;
+}
+
+static void
+data_write( libspectrum_word port GCC_UNUSED, libspectrum_byte value )
+{
+  if( current_register < 64 ) {
+    if( ulaplus_palette[ current_register ] == value ) return;
+    display_update_critical( 0, 0 );
+    ulaplus_palette[ current_register ] = value;
+    if( ulaplus_palette_enabled ) display_refresh_main_screen();
+    return;
+  }
+
+  if( current_register == 64 ) {
+    int enabled = value & 1;
+    if( enabled == ulaplus_palette_enabled ) return;
+    display_update_critical( 0, 0 );
+    ulaplus_palette_enabled = enabled;
+    display_refresh_all();
+    display_set_lores_border( ula_last_byte() & 7 );
+  }
+}
+
+static module_info_t module_info = {
+  ulaplus_reset, NULL, NULL, NULL, NULL
+};
+
+static const periph_port_t ports[] = {
+  { 0xffff, 0xbf3b, NULL, register_write },
+  { 0xffff, 0xff3b, data_read, data_write },
+  { 0, 0, NULL, NULL }
+};
+
+static const periph_t peripheral = { NULL, ports, 0, NULL };
+
+static int
+ulaplus_init( void *context GCC_UNUSED )
+{
+  module_register( &module_info );
+  periph_register( PERIPH_TYPE_ULAPLUS, &peripheral );
+  return 0;
+}
+
+void
+ulaplus_register_startup( void )
+{
+  startup_manager_module dependencies[] = { STARTUP_MANAGER_MODULE_SETUID };
+  startup_manager_register( STARTUP_MANAGER_MODULE_ULAPLUS, dependencies,
+                            ARRAY_SIZE( dependencies ), ulaplus_init, NULL,
+                            NULL );
+}
+
+void
+ulaplus_parse_colour( int colour, int *red, int *green, int *blue, int *grey )
+{
+  int g = ( colour >> 5 ) & 7;
+  int r = ( colour >> 2 ) & 7;
+  int b = ( ( colour & 3 ) << 1 ) | ( ( colour & 2 ) >> 1 ) | ( colour & 1 );
+  *green = ( g << 5 ) | ( g << 2 ) | ( g >> 1 );
+  *red = ( r << 5 ) | ( r << 2 ) | ( r >> 1 );
+  *blue = ( b << 5 ) | ( b << 2 ) | ( b >> 1 );
+  *grey = ( 299 * *red + 587 * *green + 114 * *blue + 500 ) / 1000;
+}
diff --git a/peripherals/ulaplus.h b/peripherals/ulaplus.h
new file mode 100644
index 00000000..09529f09
--- /dev/null
+++ b/peripherals/ulaplus.h
@@ -0,0 +1,16 @@
+#ifndef FUSE_ULAPLUS_H
+#define FUSE_ULAPLUS_H
+
+#include "libspectrum.h"
+
+#define ULAPLUS_CLUT_MAX_COLOURS 64
+
+extern int ulaplus_available;
+extern int ulaplus_palette_enabled;
+extern libspectrum_byte ulaplus_palette[ ULAPLUS_CLUT_MAX_COLOURS ];
+
+void ulaplus_register_startup( void );
+void ulaplus_parse_colour( int colour, int *red, int *green, int *blue,
+                           int *grey );
+
+#endif
