; Minimal HOME-side support for the dedicated calculator smoke ROMs.
; The tests exercise the production EXROM calculator and real paging path,
; but do not need the 16K BASIC interpreter or editor in their HOME image.

CALC_ENTRY_TRAMPOLINE:
    call BANK_PAGE_EXROM_IN
    jp   $C024

CALC_EXIT_TRAMPOLINE:
    jp   BANK_PAGE_EXROM_OUT

; The smoke programs do not use keyboard input. BANK_PAGE_EXROM_IN enables
; interrupts after switching, so keep the IM1 vector's target valid.
KBD_ISR_TICK:
    ret

; The production jump table has one fixed shape shared by every EXROM build.
; Calculator tests only call its CALC exit slot; point every unrelated HOME
; service at a harmless RET so the ABI stays byte-for-byte production-shaped.
CALC_SMOKE_UNUSED_KTAB_TARGET:
    ret

MEM_LABEL_TABLE_CLEAR          EQU CALC_SMOKE_UNUSED_KTAB_TARGET
MEM_LINE_FIRST                 EQU CALC_SMOKE_UNUSED_KTAB_TARGET
MEM_LINE_NEXT                  EQU CALC_SMOKE_UNUSED_KTAB_TARGET
MEM_LABEL_ADD                  EQU CALC_SMOKE_UNUSED_KTAB_TARGET
MEM_LABEL_LOOKUP               EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_PARSE_IDENTIFIER         EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_SET_PENDING_ERROR        EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_EVAL_CONDITION           EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_EVAL_EXPR                EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_EXPECT_COMMA_EXPR        EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_FIND_STATEMENT_BOUNDARY  EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_IS_LABEL_DEFINITION      EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_MATCH_ENDIF              EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_MATCH_KEYWORD_BOUNDARY   EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_PARSE_FOR_HEADER         EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_SKIP_SPACES              EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_VALIDATE_VAR_LETTER      EQU CALC_SMOKE_UNUSED_KTAB_TARGET
BASIC_EXPECT_STATEMENT_END     EQU CALC_SMOKE_UNUSED_KTAB_TARGET
MATH_MULTIPLY16                EQU CALC_SMOKE_UNUSED_KTAB_TARGET
