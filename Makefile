.PHONY: all build check smoke-build test qual qual-maint doc-examples manual-v2 rc-assets test-prod test-legacy test-all budget audit-basic manual clean cplot-extension block-extension frame-extension invert-extension ayreg-extension out-extension sprite-extension shapes-extension v2-packages v2-standalone-test release-assets

all: check build

# MAINT (study/ay-beep): this branch builds the maintenance candidate by default -- AY BEEP, SOUND
# register 0, the startup chime regenerated by code (identical register writes), the period routine
# in HOME. `make build EXTRA_DEFS=` builds the accepted release images (identical hashes).
# MAINT (study/classicbeep): plus V2_MAINT_SHARED_WAIT -- PAUSE, BEEP and the chime share one frame
# wait (HOME), which BREAK ends.
EXTRA_DEFS ?= -DV2_MAINT_SOUND0 -DV2_MAINT_AY_BEEP -DV2_MAINT_CHIME_C -DV2_MAINT_AYB_PERIOD_HOME -DV2_MAINT_SHARED_WAIT

build:
	mkdir -p build
	tools/sjasmplus_strict.sh $(EXTRA_DEFS) --sym=build/test_basic.sym --lst=build/test_basic.lst rom/v2_home.asm
	python3 tools/write_v2_crossbank.py build/test_basic.sym build/v2_crossbank.inc
	cp v2_home.bin build/test_basic.bin
	tools/sjasmplus_strict.sh $(EXTRA_DEFS) --sym=build/exrom.sym --lst=build/exrom.lst rom/v2_exrom.asm
	cp v2_exrom.bin build/exrom.bin
	tools/make_eightyone_dck.sh build/exrom.bin build/exrom.dck
	tools/sjasmplus_strict.sh rom/zesarux_combined.asm

check: build
	python3 tools/check_asm.py
	python3 tools/check_docs.py
	python3 tools/check_ram_aliases.py build/test_basic.sym
	python3 tools/check_package_abi.py
	python3 tools/check_storage_contract.py
	python3 tools/check_tape_fixture.py
	python3 tools/check_commit_validation.py
	tools/check_test_targets.sh
	python3 tools/check_builtin_tables.py
	python3 tools/test_check_basic_source.py
	# tests/err1.txt is excluded: it's tools/run_all_tests.sh's own EXPECTED_CYAN
	# fixture, deliberately testing an out-of-bounds DIM access -- a genuine,
	# intentional finding here, not a regression to fail the build over.
	python3 tools/check_basic_source.py $(filter-out tests/err1.txt,$(wildcard tests/*.txt)) demos/*.txt
	python3 tools/z80sim/test_calc_dispatcher.py
	python3 tools/z80sim/test_sprite_driver.py
	python3 tools/z80sim/test_sprite_basic_driver.py
	tools/build_smoke_roms.sh
	# Assemble-only guard for the non-production legacy/component-test
	# fixture (basic/basic.asm + rom/exrom_build.asm, see docs/v2/
	# R10_7_DORMANT_ARCHITECTURE_AUDIT.md sec3/sec6.4): this chain shares
	# kernel/memory.asm and kernel/io.asm with the real V2 production
	# build, so a future production dead-code pass can silently break it
	# unless something checks reachability against BOTH builds. `make
	# check` already runs more often than the emulator-based `make test`
	# (which is what actually caught this the one time it broke), so the
	# fast syntax/link-only check belongs here too.
	tools/sjasmplus_strict.sh -DEDITOR_TEST_EXROM rom/exrom_build.asm
	tools/sjasmplus_strict.sh -DEDITOR_AUTO_OMIT_DEF_FN rom/test_editor_auto.asm

smoke-build:
	tools/build_smoke_roms.sh

# ---------------------------------------------------------------------------
# TEST TARGETS -- read before changing.
#   make test         DEFAULT. Fully headless (ts2068-debug / ZEsarUX, no X11, no
#                     Fuse window): kernel smoke ROMs, the V2 standalone component
#                     tests, the production-ROM checks, and (R10.9) the production-ROM
#                     regression gate + strict known-defect suite. This is what to run.
#   make test-prod    Just the last two (tools/run_v2_prod_tests.sh).
#   make test-legacy  The V1 tests that drive a real Fuse window under X11
#                     (editor_auto, storage named-load family). Kept in full; they
#                     are NOT part of `make test`.
#   make test-all     Both suites.
# `make check` is unchanged (assemble/lint only; it launches no emulator).
# `make -n test | grep -i fuse` must print nothing (see docs/v2/TESTING.md).
# ---------------------------------------------------------------------------
test: all v2-packages smoke-build
	tools/run_smoke_rom_tests.sh
	tools/run_v2_standalone_tests.sh
	python3 tools/v2_production_checks.py
	python3 tools/v2_fill_check.py
	tools/run_v2_prod_tests.sh
	$(MAKE) qual
	$(MAKE) qual-maint

# RC: the qualification suites on the in-tree build (docs/v2/V2_REGRESSION_REPORT.md): the language
# corpus with the release-candidate expectations (strict PASS/FAIL/XFAIL/XPASS accounting: any FAIL,
# XPASS or BLOCKED fails the target) and the variable-session lifecycle.
qual: build v2-packages
	python3 tools/qual/qrun.py --tree . --fixed rc --out build/qual --workers-per-cfg 3
	python3 tools/qual/qlifecycle.py --tree .

# V2 maintenance qualification: AY BEEP, SOUND 0, the shared frame wait (BREAK, PAUSE rollover), the
# cbeep package (model, tape, interrupts off). Headless; logs in build/maint-qual/.
qual-maint: build v2-packages
	tools/maint/run_maint_qual.sh

# The V2 user manual's examples (docs/v2/manual/*.md): a SEPARATE suite, with its own runner and its own
# totals; it is not part of `make test` / `make qual` and does not change the 1010-case release baseline.
# Checks the manual's links/figures first (tools/check_manual.py), then runs every example on the in-tree
# image (tools/qual/manual_run.py -> build/doc-examples/results.jsonl).
doc-examples: build v2-packages
	python3 tools/check_manual.py
	python3 tools/qual/manual_run.py --out build/doc-examples --workers 4

# The Word edition of the V2 manual (the V1 manual is `make manual`).
manual-v2:
	python3 tools/build_v2_manual_docx.py

# R10.9 Phase 1: only the production-ROM regression gate + the strict known-defect suite
# (editor keys, real tape receiver fed an EAR stream, packages, package ABI). Headless.
test-prod: build v2-packages
	tools/run_v2_prod_tests.sh

test-legacy: all
	tools/run_editor_auto_test.sh
	tools/run_editor_auto_test.sh insert
	tools/run_storage_named_load_test.sh
	tools/run_storage_named_load_test.sh extension
	tools/run_storage_named_load_test.sh extension_bad_length
	tools/run_storage_named_load_test.sh extension_bad_version
	tools/run_storage_named_load_test.sh extension_wildcard
	tools/run_storage_named_load_test.sh extension_save_missing
	tools/run_storage_named_load_test.sh extension_roundtrip
	tools/run_storage_named_load_test.sh autorun_roundtrip
	tools/run_storage_named_load_test.sh autorun_zero
	tools/run_storage_named_load_test.sh autorun_trailing
	tools/run_storage_named_load_test.sh autorun_out_of_range

test-all: test test-legacy

v2-standalone-test: build
	tools/run_v2_standalone_tests.sh

budget: build
	python3 tools/report_budget.py build/test_basic.lst build/exrom.lst build/test_basic.sym
	python3 tools/report_rom_map.py build/test_basic.lst build/exrom.lst

v2-packages: build
	mkdir -p build/extensions
	tools/sjasmplus_strict.sh rom/v2_package_mode.asm
	tools/sjasmplus_strict.sh rom/v2_package_sprite.asm
	tools/sjasmplus_strict.sh rom/v2_package_printer.asm
	tools/sjasmplus_strict.sh rom/v2_package_shapes.asm
	tools/sjasmplus_strict.sh rom/v2_package_graphics.asm
	tools/sjasmplus_strict.sh rom/v2_package_cbeep.asm
	python3 tools/make_extension_tzx.py build/extensions/v2_mode.tzx MODE build/v2_package_mode.bin --v2
	python3 tools/make_extension_tzx.py build/extensions/v2_sprite.tzx SPRITE build/v2_package_sprite.bin --v2
	python3 tools/make_extension_tzx.py build/extensions/v2_printer.tzx PRINTER build/v2_package_printer.bin --v2
	python3 tools/make_extension_tzx.py build/extensions/v2_shapes.tzx SHAPES build/v2_package_shapes.bin --v2
	python3 tools/make_extension_tzx.py build/extensions/v2_graphics.tzx GRAPHICS build/v2_package_graphics.bin --v2
	python3 tools/make_extension_tzx.py build/extensions/v2_cbeep.tzx CBEEP build/v2_package_cbeep.bin --v2

